# ── Prisma ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# 注意兩組字串的「使用者名稱」格式不同，複製時容易搞混
# pooler（6543）：使用者名稱是 postgres.[project-ref]
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# direct（5432）：使用者名稱是 postgres
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"

# ── Supabase client（前端登入用）───────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── 僅後端使用，絕對不能加 NEXT_PUBLIC_ 前綴 ───────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=""

# ── seed 用：要塞資料給哪個使用者（Supabase Auth 的 user id, UUID）─────────
SEED_USER_ID=""

# ── Web Push（每日記帳提醒）────────────────────────────────────────────────
# 用 npx web-push generate-vapid-keys 產生
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# 保護 /api/cron/reminder，避免任何人都能觸發推播
CRON_SECRET=""
