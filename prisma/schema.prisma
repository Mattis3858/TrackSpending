// 個人記帳系統 — Prisma schema
// 對應 SPEC.md 第 4 節。修改前請先讀 SPEC.md 第 5 節「核心設計決策」。

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7：連線字串在 prisma.config.ts 設定，不在這裡
}

/// 支出分類的性質。互斥，取代原本 isSavings / isFixed 之類的多個布林旗標。
/// 只對 EXPENSE 分類有意義，INCOME 分類一律留 VARIABLE 並忽略。
enum CategoryKind {
  VARIABLE // 變動消費：餐飲、交通、娛樂
  FIXED // 固定消費：房租、水電瓦斯、保險。金額穩定、短期內砍不掉
  SAVINGS // 儲蓄：錢存起來，仍然是現金，可以動用
  INVESTMENT // 投資：錢投入股票 / ETF，離開現金部位
}

/// 股票掛牌的市場，決定要去哪個公開 API 抓報價
enum Market {
  TWSE // 上市（證交所）
  TPEX // 上櫃（櫃買中心）
  US   // 美股（複委託），報價與成本以美元計，總計時換算台幣
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id          String          @id @default(cuid())
  userId      String // Supabase auth.users.id
  name        String
  type        TransactionType
  isDefault   Boolean         @default(false) // 系統內建分類，不可刪除
  kind        CategoryKind    @default(VARIABLE) // 見 SPEC 5.2 / 5.8
  archived    Boolean         @default(false) // 軟刪除，見 SPEC 5.4
  color       String? // 圓餅圖固定色，hex
  sortOrder   Int             @default(0)
  budgetLimit Decimal?        @db.Decimal(10, 2) // Phase 2 才做 UI
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions Transaction[]
  templates    RecurringTemplate[]

  @@unique([userId, name, type]) // 防止 seed 重跑產生重複分類
  @@index([userId, archived])
}

/// 使用者層級的設定值。單一使用者也用 userId 當主鍵，未來多人不必改結構。
model UserSetting {
  userId String @id

  /// 開始記帳前手上已有的現金類資產（活存、定存、緊急備用金）。
  /// 沒有這個值，緊急預備金月數會嚴重低估。見 SPEC 8.5
  startingCash       Decimal   @default(0) @db.Decimal(12, 2)
  /// 外幣現金（美元），例如複委託帳戶裡還沒投入的餘額。
  /// 交易紀錄都是台幣，所以這個值由使用者自己維護。
  cashUsd            Decimal   @default(0) @db.Decimal(12, 2)
  // 投資部位一律以 Holding（持股明細）為單一事實來源。
  // 原本的 startingInvestment / investmentValue 已移除：兩個來源會讓
  // 使用者改了設定卻發現數字不動，而且持股 + 即時報價是它們的上位替代。

  /// 月消費預算。沒設定時用「近期收入 x (1 - 目標儲蓄率)」推算
  monthlyBudget     Decimal? @db.Decimal(10, 2)
  /// 目標儲蓄率，0-100
  targetSavingsRate Int?
  /// 發薪日（每月幾號），給倒數用
  payday            Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id             String   @id @default(cuid())
  userId         String
  name           String // 例如：薪轉戶、儲蓄戶、現金
  initialBalance Decimal  @default(0) @db.Decimal(12, 2)
  archived       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromTransactions Transaction[] @relation("fromAccount")
  toTransactions   Transaction[] @relation("toAccount")

  @@unique([userId, name])
}

model Transaction {
  id     String          @id @default(cuid())
  userId String
  date   DateTime        @db.Date // 純日期，不帶時刻，避免時區錯月，見 SPEC 5.3
  type   TransactionType
  amount Decimal         @db.Decimal(10, 2) // 一律為正數，見 SPEC 5.5
  note   String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  accountId   String? // Phase 2：TRANSFER 的轉出帳戶
  account     Account? @relation("fromAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccountId String? // Phase 2：TRANSFER 的轉入帳戶
  toAccount   Account? @relation("toAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  importHash String? // Phase 2 CSV 匯入去重用
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recurringRun RecurringRun?

  @@unique([userId, importHash]) // Postgres 多筆 NULL 視為相異，不影響手動輸入
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([categoryId])
}

model RecurringTemplate {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // 沒有 type 欄位：類型一律由 category.type 決定，避免兩邊不一致
  amount     Decimal  @db.Decimal(10, 2)
  dayOfMonth Int // 1-31，超過當月天數時 clamp 到該月最後一天，見 SPEC 5.6
  note       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs RecurringRun[]

  @@index([userId, active])
}

// 記錄「某範本在某月已經產生過交易」，靠 unique 約束保證不會重複產生
model RecurringRun {
  id            String            @id @default(cuid())
  templateId    String
  template      RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  yearMonth     String // 格式固定 "2026-09"
  transactionId String?           @unique
  transaction   Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())

  @@unique([templateId, yearMonth])
}

/// 持股明細。有了它就能自動算投資現值，不必手動維護 UserSetting.investmentValue。
/// 成本由使用者維護（買賣時更新），現值由公開報價 API 即時計算。
model Holding {
  id     String @id @default(cuid())
  userId String

  symbol String /// 股票代號，例如 2330
  name   String /// 名稱，新增時由報價 API 帶入，可自行修改
  market Market @default(TWSE)

  /// 股數。複委託的零股常有 5 位小數，整數位仍保留 10 位
  shares Decimal @db.Decimal(15, 5)
  /// 累計投入成本（總額，不是單價）
  cost   Decimal @db.Decimal(12, 2)

  note      String?
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, archived])
}

/// Web Push 訂閱。同一個使用者可以有多個裝置，所以不是一對一。
/// endpoint 是推播服務商給的唯一網址，拿它當唯一鍵就能自然去重。
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  endpoint String @unique
  /// 加密用的金鑰，由瀏覽器產生
  p256dh   String
  auth     String

  /// 裝置描述，方便使用者辨認要取消哪一台
  userAgent String?
  /// 最後一次成功推播的時間；連續失敗的訂閱會被清掉
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

/// 報價快取。**不是租戶資料**——市場報價人人相同，快取一份大家共用。
///
/// 存在的理由：Next.js 的 fetch 快取是「依渲染它的路由檔案標記」的，
/// 所以任何 revalidatePath("/")（例如記一筆帳）都會把報價快取一起清掉，
/// 下次開首頁又要跑去台灣重抓 300KB。存在自己的資料庫就完全不受影響，
/// 而且函式與資料庫同區，讀取只要幾毫秒。
///
/// 只快取「使用者實際持有的代號」，不是全市場 2,000 多檔。
model QuoteCache {
  symbol    String   @id
  name      String
  market    Market
  price     Decimal  @db.Decimal(18, 6)
  /// 報價所屬日期 YYYY-MM-DD
  quoteDate String
  fetchedAt DateTime @default(now())
}

/// 匯率快取，理由同上
model FxRateCache {
  pair      String   @id /// 例如 USDTWD
  rate      Decimal  @db.Decimal(18, 6)
  rateDate  String?
  fetchedAt DateTime @default(now())
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  totalAssets Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([userId, date])
}
